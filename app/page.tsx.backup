"use client";

export default function Home() {
  const startChat = () => {
    window.location.href = "/chat";
  };

  return (
    <main
      style={{
        display: "flex",
        justifyContent: "center",
        alignItems: "center",
        height: "100vh",
        background: "#111827",
        color: "white",
        flexDirection: "column",
        fontFamily: "Arial",
      }}
    >
      <h1>🤖 Sweety AI</h1>

      <p>Welcome! Your AI assistant is ready.</p>

      <button
        onClick={startChat}
        style={{
          padding: "12px 25px",
          marginTop: "20px",
          background: "#2563eb",
          color: "white",
          border: "none",
          borderRadius: "8px",
          cursor: "pointer",
          fontSize: "16px",
        }}
      >
        Start Chat
      </button>
    </main>
  );
}